# Configurações do HomeMed
PORT=5000

# URL do Banco de Dados PostgreSQL (Neon / Vercel Postgres / Supabase / Local)
# Exemplo Neon/Vercel Postgres: postgres://default:senhaxxx@ep-xyz.us-east-1.aws.neon.tech/verceldb?sslmode=require
DATABASE_URL=postgres://postgres:root@localhost:5432/homemed_db

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui
